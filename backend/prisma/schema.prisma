generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Identity {
  walletAddress   String   @id
  did             String   @unique
  didDocumentHash String
  isVerified      Boolean  @default(false)
  isRevoked       Boolean  @default(false)
  isQuarantined   Boolean  @default(false)
  registeredAt    DateTime @default(now())

  roles  Role[]
  assets Asset[]
  audits AuditEntry[] @relation("ActorAudits")
}

model Role {
  id              Int      @id @default(autoincrement())
  role            String   // e.g. ADMIN_ROLE
  identityWallet  String
  identity        Identity @relation(fields: [identityWallet], references: [walletAddress])

  @@unique([role, identityWallet])
}

model Asset {
  tokenId         Int      @id
  metadataHash    String
  ipfsCid         String?
  mintedAt        DateTime @default(now())
  isRevoked       Boolean  @default(false)
  ownerWallet     String
  owner           Identity @relation(fields: [ownerWallet], references: [walletAddress])
}

model AuditEntry {
  id              Int      @id
  actionType      String
  actorWallet     String
  actor           Identity @relation("ActorAudits", fields: [actorWallet], references: [walletAddress])
  relatedUser     String?
  relatedAssetId  Int?
  details         String
  timestamp       DateTime
  blockNumber     Int
}

model SecurityAlert {
  id           Int      @id @default(autoincrement())
  severity     String   // CRITICAL, HIGH, MEDIUM, LOW
  tactic       String   // Privilege Escalation, Mass Exfiltration, Off-Hours Burst, Unauthorized Probing
  description  String
  targetWallet String?
  threatScore  Int
  status       String   @default("ACTIVE") // ACTIVE, RESOLVED, QUARANTINED
  createdAt    DateTime @default(now())
}

model Proposal {
  id                 String              @id @default(uuid())
  title              String
  actionType         String              // MINT_CLASSIFIED, REVOKE_ASSET, GRANT_CLEARANCE, EMERGENCY_LOCK
  description        String
  targetResource     String?
  requiredSignatures Int                 @default(2)
  status             String              @default("PENDING") // PENDING, APPROVED, EXECUTED, REJECTED
  creatorWallet      String
  createdAt          DateTime            @default(now())
  signatures         ProposalSignature[]
}

model ProposalSignature {
  id            Int      @id @default(autoincrement())
  proposalId    String
  proposal      Proposal @relation(fields: [proposalId], references: [id])
  officerWallet String
  officerRole   String
  signature     String
  signedAt      DateTime @default(now())

  @@unique([proposalId, officerWallet])
}
